# Copie para .env (ignorado pelo git). Nunca commite chaves reais.
POSTGRES_USER=leia
POSTGRES_PASSWORD=leia
POSTGRES_DB=leia
DATABASE_URL=postgresql+psycopg://leia:leia@localhost:5432/leia

# Modelo via LiteLLM. Dev: gratuito. Demo/avaliação final: anthropic/claude-haiku-5-5
LEIA_MODEL=gemini/gemini-flash-lite-latest
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Carrega os modelos de busca e o cliente de LLM na subida da API (a 1ª mensagem não fica lenta).
AQUECER_MODELOS=true
# Candidatos repontuados pelo reranker (custo dominante da busca em CPU). Reduzir para 25 ou 35
# piorou a suíte de busca; só mude passando pelo run_busca.py.
# RERANKER_CANDIDATOS=50
