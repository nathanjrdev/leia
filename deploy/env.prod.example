# Copie para .env na raiz do repositório, NA VPS, e preencha. Nunca commite o .env.
DOMINIO=SEU-IP-COM-PONTOS.sslip.io
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Modelo da demo (o medido na suíte: 54/55) e a chave dele.
LEIA_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=

# Opcional: entrar com Google / Microsoft (ver docs/deploy.md). Sem id + segredo o botão some.
# Retornos a cadastrar: https://DOMINIO/api/auth/oauth/google/retorno e .../microsoft/retorno
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Opcional: token do Hugging Face (só leitura) para baixar os modelos sem limite anônimo.
# HF_TOKEN=
